# Copy to .env and fill in. Never commit .env.
ADMIN_PASSWORD=change-me
# Random string; keeps admin logged in across restarts. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 1 when served over HTTPS (e.g. through Cloudflare Tunnel), 0 for plain http on the LAN.
SECURE_COOKIES=0
# New participant sessions per minute from one IP. Raise if a big group shares one network.
RATE_LIMIT_PER_MIN=120
# Where the SQLite database lives on the host (Synology default shown).
DATA_PATH=/volume1/docker/compair/data
# Synology: the UID/GID that owns DATA_PATH (run `id` over SSH, or use 1026:100 for the first admin user).
PUID=1000
PGID=1000
# Only for the optional Caddy HTTPS profile: the public hostname, e.g. 3-91-12-34.sslip.io
SITE_ADDRESS=
# Only for the optional Cloudflare Tunnel profile.
TUNNEL_TOKEN=
